<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <!-- Single source of truth: the VERSION file at the repo root (major.minor.patch). scripts/deploy-gondor.sh bumps the patch on every deploy. -->
    <SsVersion Condition="Exists('$(MSBuildThisFileDirectory)../VERSION')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../VERSION').Trim())</SsVersion>
    <SsVersion Condition="'$(SsVersion)' == ''">0.1.0</SsVersion>
    <Version>$(SsVersion).0</Version>
    <AssemblyVersion>$(SsVersion).0</AssemblyVersion>
    <FileVersion>$(SsVersion).0</FileVersion>
    <InformationalVersion>$(SsVersion)</InformationalVersion>
    <Description>Second-screen web companion for FFXIV: view live game data from a browser on your LAN.</Description>
    <PackageProjectUrl>https://github.com/stridera/SecondScreen</PackageProjectUrl>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EmbedIO" Version="3.5.2" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <!-- QRCoder only needs System.Drawing.Common for its bitmap renderers, which we do not use; keep it out of the output so it cannot clash with Dalamud. -->
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="6.0.0" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>
</Project>
